# ─── Site ─────────────────────────────────────────────────────────────
# Public URL, no trailing slash. Used for canonical URLs, hreflang, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.sa

# ─── Contact channels (shown on the site only when set) ───────────────
# These are read at build time: rebuild/redeploy after changing them.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=          # display format, e.g. +966 5X XXX XXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=        # international digits, e.g. 9665XXXXXXXX
NEXT_PUBLIC_BOOKING_URL=            # Calendly / Cal.com / Microsoft Bookings link
NEXT_PUBLIC_LOCATION_EN=            # e.g. Riyadh, Saudi Arabia
NEXT_PUBLIC_LOCATION_AR=            # e.g. الرياض، المملكة العربية السعودية

# ─── Social links (each shown only when set) ──────────────────────────
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_SNAPCHAT=

# ─── Enquiry delivery (server-side secrets; configure at least one) ───
# Without either channel the form shows a clear "not connected" message and
# never claims success. When both are set, both must succeed.

# Option A: email via Resend (https://resend.com). The FROM address must be on a verified domain.
RESEND_API_KEY=
CONTACT_TO_EMAIL=                   # comma-separated recipients
CONTACT_FROM_EMAIL=                 # e.g. "NamowKSA Website <enquiries@your-domain.sa>"

# Option B: CRM or automation webhook (HubSpot workflow, Zoho, Make, Zapier, n8n…)
# Receives a JSON POST: { source, type, fullName, businessName, email, phone,
# businessType, service, serviceLabel, requirements, contactMethod, consent, locale, submittedAt }
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=                 # optional; sent as "Authorization: Bearer <secret>"
